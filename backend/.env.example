# Copia este archivo a ".env" (en esta misma carpeta, backend/) y completa los
# valores. Es el ÚNICO archivo de configuración del proyecto — lo usan tanto
# NestJS/Prisma en local como Docker Compose (vía env_file).

# --- Base de datos ---
# POSTGRES_* inicializan el contenedor "db". DATABASE_URL de abajo es la que
# usa el backend cuando corre en LOCAL (fuera de Docker), con host "localhost".
# Dentro de Docker, docker-compose.yml sobreescribe DATABASE_URL con el mismo
# usuario/password pero host "db" — si cambias POSTGRES_PASSWORD aquí,
# actualiza también esa línea en docker-compose.yml (servicio "app").
POSTGRES_USER=facturas
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=facturas
DATABASE_URL="postgresql://facturas:cambia-esta-clave@localhost:5432/facturas?schema=public"

# --- Autenticación ---
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Usuario admin inicial (usado por `pnpm db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambiar123

# --- Servidor (en Docker, docker-compose.yml sobreescribe UPLOAD_DIR y PORT) ---
PORT=3000
UPLOAD_DIR=./uploads

# --- Gemini (extracción de facturas) — gratis en https://aistudio.google.com/apikey ---
GEMINI_API_KEY=<tu-api-key>
# Modelo usado para toda extracción. Verificar el ID vigente en
# https://aistudio.google.com/ antes de cambiarlo (confirmado disponible via
# ListModels). El free tier de flash-lite da ~15 requests/min — GEMINI_MIN_INTERVALO_MS
# de abajo está calibrado para no pasarse de eso.
GEMINI_MODEL=gemini-3.5-flash-lite
# Cuántas facturas van juntas en un solo request a Gemini. Subir muchas fotos
# a la vez se agrupa así en vez de un request por foto — evita chocar con el
# límite de requests/minuto del free tier. 10 es un punto de equilibrio entre
# velocidad y riesgo de que el modelo mezcle datos entre facturas parecidas.
GEMINI_TAMANO_LOTE=10
# Espacio mínimo entre el INICIO de dos requests a Gemini, sin importar cuántos
# documentos se estén procesando "a la vez" — con 4000ms el techo es 15/min,
# igual al límite del free tier de flash-lite. Bajalo si tenés facturación
# habilitada (más cuota) o subilo si igual ves 429.
GEMINI_MIN_INTERVALO_MS=4000

# --- Procesador de documentos ---
# Cada tick vacía TODA la cola de pendientes (de a lotes de GEMINI_TAMANO_LOTE)
# antes de esperar el próximo — este intervalo solo define cuánto tarda en
# arrancar trabajo nuevo que llegó después de vaciar la cola.
PROCESADOR_INTERVALO_MS=3000
UMBRAL_CONFIANZA=0.85
